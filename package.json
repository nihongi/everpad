{
  "name": "everpad",
  "productName": "EverPad",
  "desktopName": "everpad.desktop",
  "version": "0.22.0",
  "description": "テキストとMarkdownで書けて、全編集の履歴をタイムスライダーで巻き戻せるメモ帳",
  "main": "main.js",
  "private": true,
  "author": "Nobuyoshi NIHONGI",
  "license": "MIT",
  "homepage": "https://github.com/nihongi/everpad/",
  "repository": {
    "type": "git",
    "url": "https://github.com/nihongi/everpad.git"
  },
  "scripts": {
    "vendor:katex": "node tools/vendor-katex.js",
    "prestart": "node tools/vendor-katex.js",
    "start": "electron .",
    "test": "node --test",
    "predist": "node tools/vendor-katex.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "local.everpad.app",
    "productName": "EverPad",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "contextmenu.js",
      "windowstate.js",
      "sendto.js",
      "textcodec.js",
      "archive.js",
      "datalock.js",
      "portable.js",
      "macmenu.js",
      "updatecheck.js",
      "ziplite.js",
      "build/icon.ico",
      "build/icon.png",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "fileAssociations": [
        {
          "ext": "everpad",
          "name": "EverPad.Archive",
          "description": "EverPad Archive",
          "icon": "icon.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ja_JP"
      ],
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "EverPad saves your notes in the Documents folder."
      },
      "fileAssociations": [
        {
          "ext": "everpad",
          "name": "EverPad Archive",
          "description": "EverPad Archive",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "everpad",
      "target": [
        "AppImage"
      ],
      "syncDesktopName": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    }
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "katex": "^0.19.0"
  }
}
